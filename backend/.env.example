# ============================================================
#  LearnMate Backend — Environment Variables Template
#  Copy this file to .env and fill in your real credentials.
# ============================================================

PORT=5000
NODE_ENV=development

# IBM watsonx.ai credentials (IBM Cloud Lite)
WATSONX_API_KEY="YOUR WATSONX_API_KEY"
WATSONX_PROJECT_ID="YOUR WATSONX_PROJECT_ID"
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct
IBM_IAM_URL=https://iam.cloud.ibm.com/identity/token

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_TTL=86400
